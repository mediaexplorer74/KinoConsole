<Page
    x:Class="KinoConsole.TestErrorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KinoConsole"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0">
            <Button Content="Test Unhandled Exception" 
                    Click="TestUnhandledException_Click"
                    HorizontalAlignment="Center"/>
            
            <Button Content="Test Async Exception" 
                    Click="TestAsyncException_Click"
                    HorizontalAlignment="Center"/>
            
            <Button Content="View Log File" 
                    Click="ViewLogFile_Click"
                    HorizontalAlignment="Center"/>
            
            <TextBlock x:Name="LogContent" 
                       TextWrapping="Wrap" 
                       MaxWidth="400"
                       Text="Log content will appear here"/>
        </StackPanel>
    </Grid>
</Page>
